{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",
  "name": "site1",
  "main": "src/index.js",
  "compatibility_date": "2026-10-12",
  "vars": {
    "CONTACT_FROM_EMAIL": "requests@send.alirezade.ir",
    "CONTACT_TO_EMAIL": "alirezazadehbeglar@gmail.com"
  },
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  }
}
